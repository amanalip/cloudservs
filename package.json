{
  "name": "cloudservs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-astro-private.ts dev",
    "build": "npm run syllabus:validate && npm run docs:validate && npm run guidance:validate && npm run check && node scripts/run-astro-private.ts build && npm run privacy:validate",
    "preview": "node scripts/run-astro-private.ts preview",
    "check": "node scripts/run-astro-private.ts check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "npm run build && playwright test --ui",
    "syllabus:status": "node scripts/syllabus-status.ts",
    "syllabus:validate": "node scripts/validate-syllabus.ts",
    "docs:validate": "node scripts/validate-documentation-sync.ts",
    "guidance:validate": "node scripts/validate-agent-guidance.ts",
    "privacy:validate": "node scripts/validate-privacy.ts",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/preact": "6.0.1",
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/starlight": "0.41.3",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@nanostores/persistent": "1.3.5",
    "astro": "7.1.3",
    "chart.js": "4.5.1",
    "cytoscape": "3.34.0",
    "driver.js": "1.4.0",
    "lucide-preact": "1.25.0",
    "markmap-lib": "0.18.12",
    "markmap-view": "0.18.12",
    "mermaid": "11.16.0",
    "nanostores": "1.4.1",
    "preact": "10.29.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "@playwright/test": "1.61.1",
    "@types/cytoscape": "3.21.9",
    "axe-core": "4.12.1",
    "prettier": "3.6.2",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
