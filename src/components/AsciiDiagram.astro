---
/**
 * ASCII diagrams remain useful when copied into notes, terminals, and interview prep.
 * The copy button is progressively enhanced, so the diagram remains readable without JavaScript.
 */
interface Props {
  title: string;
  caption: string;
  diagram: string;
}

const { title, caption, diagram } = Astro.props;
---

<figure class="diagram-card" data-ascii-diagram>
  <figcaption class="diagram-card__header">
    <div>
      <h3>{title}</h3>
      <p>{caption}</p>
    </div>
    <button class="diagram-copy" type="button" aria-label={`Copy ${title}`} aria-live="polite">
      Copy
    </button>
  </figcaption>
  <div class="diagram-card__body">
    <pre><code>{diagram}</code></pre>
  </div>
</figure>

<script>
  /** Copy text in secure browsers and fall back for local or restricted contexts. */
  async function copyText(text: string): Promise<void> {
    if (navigator.clipboard?.writeText && window.isSecureContext) {
      try {
        await navigator.clipboard.writeText(text);
        return;
      } catch {
        // Continue to the selection-based fallback when clipboard permission is denied.
      }
    }

    const temporaryInput = document.createElement('textarea');
    temporaryInput.value = text;
    temporaryInput.setAttribute('readonly', '');
    temporaryInput.style.position = 'fixed';
    temporaryInput.style.inset = '0 auto auto -9999px';
    document.body.append(temporaryInput);
    temporaryInput.select();
    const legacyDocument = document as unknown as { execCommand(commandId: string): boolean };
    const copied = legacyDocument.execCommand('copy');
    temporaryInput.remove();

    if (!copied) throw new Error('The browser rejected both clipboard methods.');
  }

  /** Bind copy behavior on initial load and after each Starlight navigation. */
  function prepareAsciiCopyButtons() {
    document.querySelectorAll<HTMLElement>('[data-ascii-diagram]').forEach((card) => {
      const button = card.querySelector<HTMLButtonElement>('.diagram-copy');
      const code = card.querySelector<HTMLElement>('code');

      /** A data flag prevents duplicate listeners when a page is revisited. */
      if (!button || !code || button.dataset.ready === 'true') return;
      button.dataset.ready = 'true';

      button.addEventListener('click', async () => {
        button.disabled = true;

        try {
          await copyText(code.textContent ?? '');
          button.textContent = 'Copied';
        } catch (error) {
          button.textContent = 'Copy failed';
          console.error('cloudservs could not copy this ASCII diagram.', error);
        }

        button.focus({ preventScroll: true });
        window.setTimeout(() => {
          button.textContent = 'Copy';
          button.disabled = false;
        }, 1600);
      });
    });
  }

  prepareAsciiCopyButtons();
  document.addEventListener('astro:page-load', prepareAsciiCopyButtons);
</script>
